{
  "name": "webshield",
  "version": "1.0.0",
  "description": "WebShield — AI-powered automated web security scanning platform",
  "private": true,
  "packageManager": "npm@11.17.0",
  "workspaces": [
    "backend",
    "Webshield"
  ],
  "scripts": {
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=Webshield",
    "build:backend": "npm run build --workspace=backend",
    "build:frontend": "npm run build --workspace=Webshield",
    "test:backend": "npm run test --workspace=backend",
    "migrate:latest": "npm run migrate:latest --workspace=backend",
    "migrate:rollback": "npm run migrate:rollback --workspace=backend"
  },
  "engines": {
    "node": "24.x"
  }
}
