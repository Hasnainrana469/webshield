# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/webshield
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/webshield_test

# JWT
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
JWT_EXPIRY=24h

# OWASP ZAP
ZAP_API_URL=http://localhost:8080
ZAP_API_KEY=your-zap-api-key

# AI Provider (set only one)
OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...
AI_PROVIDER=openai

# Email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASS=your-smtp-password
SMTP_FROM=WebShield <noreply@example.com>

# CORS / Frontend
FRONTEND_URL=http://localhost:5173

# Server
PORT=3001
NODE_ENV=development

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:3001
