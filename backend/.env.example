# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/webshield

# JWT
JWT_SECRET=change-this-to-a-strong-random-secret-at-least-32-chars
JWT_EXPIRY=86400

# URLs
FRONTEND_URL=http://localhost:5173
API_BASE_URL=http://localhost:3001
PORT=3001

# OWASP ZAP (optional — SQL injection and XSS modules use ZAP if configured)
ZAP_API_URL=http://localhost:8080
ZAP_API_KEY=

# AI Provider (set one to enable AI features)
OPENAI_API_KEY=
GEMINI_API_KEY=

# Email / SMTP (optional — required for email notifications)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="WebShield <no-reply@example.com>"

# Reports storage directory
REPORTS_DIR=./reports
